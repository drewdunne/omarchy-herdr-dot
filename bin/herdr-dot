#!/usr/bin/env python3
"""herdr-dot: the herdr agents waiting for you, across every session on every machine.

  herdr-dot watch [--remote TARGET]...   stream the list as JSON, one line per change
                                           (the bar widget runs this); reads commands on
                                           stdin: `go <key>`, `first`, `refresh`
  herdr-dot list [--remote TARGET]...    print the list once and exit
                                           Without --remote, both use the plugin's `remotes`
                                           setting in Omarchy's shell.json (watch follows
                                           changes to it); --local-only skips remote hosts
  herdr-dot windows                      print which window shows which herdr session
  herdr-dot plan TARGET SESSION          print what going to that session would do
                                           (TARGET is `local` or an SSH target)

What "waiting for you" means (see README): an agent starts waiting when it leaves
`working` (finished, or asking a question), and stops when you have had it in front
of you for a second (its tab shown in the herdr window that has focus on your
desktop), when you go to it from the list, or when it starts working again. An agent
asking a question stays on the list until it is answered, except while it is in
front of you.

Every machine is read by herdr_dot_relay.py: run directly here, and over SSH on
remote targets (its source travels with the command; nothing is installed there).
"""

import argparse
import base64
import json
import os
import queue
import socket
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.realpath(__file__))
RELAY = os.path.join(HERE, "herdr_dot_relay.py")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "herdr-dot")
STATE_FILE = os.path.join(STATE_DIR, "waiting.json")
LOCAL = "local"
SEEN_AFTER = 1.0          # seconds an agent must be in front of you to count as seen
TICK = 0.5
WINDOW_RESCAN = 15.0
RETRY_MAX = 60.0
FINISHED_STATES = ("done", "idle")


def log(*parts):
    sys.stderr.write("herdr-dot: " + " ".join(str(p) for p in parts) + "\n")
    sys.stderr.flush()


# ---------------------------------------------------------------- hosts

_identity_cache = {}


def ssh_identity(target):
    """user@hostname:port as SSH resolves TARGET, so `server` and `me@server` match."""
    if target in _identity_cache:
        return _identity_cache[target]
    values = {}
    try:
        out = subprocess.run(["ssh", "-G", target], capture_output=True, text=True, timeout=5,
                             stdin=subprocess.DEVNULL).stdout
        for line in out.splitlines():
            key, _, value = line.partition(" ")
            if key in ("user", "hostname", "port"):
                values[key] = value.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    if values.get("hostname"):
        identity = "%s@%s:%s" % (values.get("user", ""), values["hostname"].lower(), values.get("port", "22"))
    else:
        identity = target
    _identity_cache[target] = identity
    return identity


def short_label(target):
    """`me@server.example.ts.net` -> `server`."""
    host = target.split("@")[-1]
    if host.startswith("[") and "]" in host:
        return host[1:host.index("]")]
    return host.split(":")[0].split(".")[0]


def relay_command(target):
    if target is None:
        return [sys.executable, "-u", RELAY]
    with open(RELAY, "rb") as handle:
        source = base64.b64encode(handle.read()).decode()
    bootstrap = ("python3 -u -c 'import base64,sys;exec(compile(base64.b64decode(sys.argv[1]),"
                 "\"herdr-dot-relay\",\"exec\"))' " + source)
    return ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
            "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=2", target, bootstrap]


class Host(threading.Thread):
    """One machine: keeps its relay running and passes its messages on."""

    def __init__(self, key, label, target, events):
        threading.Thread.__init__(self, daemon=True)
        self.key = key
        self.label = label
        self.target = target
        self.events = events
        self.proc = None
        self.lock = threading.Lock()
        self.ok = False
        self.error = ""
        self.since = time.time()
        self.stopped = threading.Event()

    def stop(self):
        self.stopped.set()
        with self.lock:
            if self.proc is not None and self.proc.poll() is None:
                self.proc.terminate()

    def send(self, message):
        with self.lock:
            proc = self.proc
            if proc is None or proc.poll() is not None:
                return False
            try:
                proc.stdin.write(json.dumps(message) + "\n")
                proc.stdin.flush()
                return True
            except (OSError, ValueError):
                return False

    def run(self):
        delay = 5.0
        while not self.stopped.is_set():
            started = time.time()
            stderr_tail = []
            try:
                proc = subprocess.Popen(relay_command(self.target), stdin=subprocess.PIPE,
                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                        text=True, bufsize=1)
            except OSError as error:
                proc = None
                stderr_tail.append(str(error))
            if proc is not None:
                with self.lock:
                    self.proc = proc

                def drain(stream, tail):
                    for line in stream:
                        line = line.strip()
                        if line:
                            tail.append(line)
                            del tail[:-3]
                threading.Thread(target=drain, args=(proc.stderr, stderr_tail), daemon=True).start()
                for line in proc.stdout:
                    try:
                        message = json.loads(line)
                    except ValueError:
                        continue
                    if message.get("type") == "hello":
                        self.ok = True
                        self.error = ""
                        self.since = time.time()
                        delay = 5.0
                    self.events.put(("relay", self.key, message))
                proc.wait()
                time.sleep(0.2)  # let the stderr reader finish
            reason = stderr_tail[-1] if stderr_tail else "connection closed"
            if "Permission denied" in reason or "Host key verification failed" in reason:
                reason = "SSH needs you to log in (run: ssh %s)" % self.target
            if self.ok or not self.error:
                self.since = time.time()
            if self.stopped.is_set():
                return
            self.ok = False
            self.error = reason
            self.events.put(("down", self.key, reason))
            if time.time() - started > 60:
                delay = 5.0
            self.stopped.wait(delay)
            delay = min(delay * 2, RETRY_MAX)


SHELL_CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                            "omarchy", "shell.json")
PLUGIN_ID = "gg.arkship.herdr-dot"


def configured_remotes(path=SHELL_CONFIG):
    """The `remotes` setting of this plugin's entry in Omarchy's shell.json, or None if unreadable."""
    try:
        with open(path) as handle:
            config = json.load(handle)
    except (OSError, ValueError):
        return None
    layout = ((config.get("bar") or {}).get("layout") or {})
    for section in layout.values():
        for entry in section if isinstance(section, list) else []:
            if isinstance(entry, dict) and entry.get("id") == PLUGIN_ID:
                return remotes_from([str(entry.get("remotes") or "")])
    return []


# ---------------------------------------------------------------- desktop

def hyprctl(*args, timeout=3):
    try:
        return subprocess.run(["hyprctl"] + list(args), capture_output=True, text=True,
                              timeout=timeout, stdin=subprocess.DEVNULL).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def hypr_json(what):
    try:
        return json.loads(hyprctl(what, "-j") or "null")
    except ValueError:
        return None


def norm_address(address):
    address = str(address or "").strip().lower()
    return address[2:] if address.startswith("0x") else address


def process_table():
    """{pid: (parent pid, argv, environ HERDR_SESSION or None)} for this user's processes."""
    table = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open("/proc/%s/stat" % entry, "rb") as handle:
                stat = handle.read().decode("utf-8", "replace")
            parent = int(stat[stat.rindex(")") + 2:].split()[1])
            with open("/proc/%s/cmdline" % entry, "rb") as handle:
                argv = [a.decode("utf-8", "replace") for a in handle.read().split(b"\0") if a]
        except (OSError, ValueError, IndexError):
            continue
        table[int(entry)] = (parent, argv)
    return table


def herdr_session_env(pid):
    try:
        with open("/proc/%d/environ" % pid, "rb") as handle:
            for item in handle.read().split(b"\0"):
                if item.startswith(b"HERDR_SESSION="):
                    return item.split(b"=", 1)[1].decode("utf-8", "replace") or None
    except OSError:
        pass
    return None


def parse_client(args, env_session=None):
    """(remote target or None, session) for a herdr TUI client's arguments, else None."""
    if len(args) >= 3 and args[0] == "session" and args[1] == "attach":
        return (None, args[2])
    session = None
    remote = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("--session", "--remote", "--remote-keybindings") and i + 1 < len(args):
            if arg == "--session":
                session = args[i + 1]
            elif arg == "--remote":
                remote = args[i + 1]
            i += 2
            continue
        if arg.startswith("--session="):
            session = arg.split("=", 1)[1]
        elif arg.startswith("--remote="):
            remote = arg.split("=", 1)[1]
        elif arg.startswith("--remote-keybindings=") or arg == "--handoff":
            pass
        else:
            return None  # a subcommand (server, client, api, agent, …) or something unknown
        i += 1
    if session is None and remote is None:
        session = env_session
    return (remote, session or "default")


def window_map(host_key_for):
    """{address: {"address", "workspace", "focus_rank", "clients": [(host key, session)]}}."""
    clients = hypr_json("clients") or []
    by_pid = {}
    windows = {}
    for client in clients:
        address = norm_address(client.get("address"))
        workspace = (client.get("workspace") or {}).get("id")
        windows[address] = {"address": address, "workspace": workspace,
                            "focus_rank": client.get("focusHistoryID", 999), "clients": []}
        by_pid.setdefault(client.get("pid"), []).append(address)
    table = process_table()
    for pid, (parent, argv) in table.items():
        if not argv or os.path.basename(argv[0]) != "herdr":
            continue
        parsed = parse_client(argv[1:], herdr_session_env(pid))
        if parsed is None:
            continue
        remote, session = parsed
        host = LOCAL if remote is None else host_key_for(remote)
        seen = set()
        current = pid
        while current and current not in seen:
            seen.add(current)
            if current in by_pid:
                if len(by_pid[current]) == 1:  # a terminal process that owns one window
                    windows[by_pid[current][0]]["clients"].append((host, session))
                break
            current = table.get(current, (0, []))[0]
    return windows


def active_workspace():
    data = hypr_json("activeworkspace") or {}
    return data.get("id")


def focus_window(address):
    out = hyprctl("dispatch", 'hl.dsp.focus({ window = "address:0x%s" })' % address)
    if out.strip() != "ok":
        hyprctl("dispatch", "focuswindow", "address:0x%s" % address)


SESSION_MANAGER = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                               "herdr-session-manager", "workspaces.json")


def session_workspaces(host_key_for, path=SESSION_MANAGER):
    """{workspace number: (host key, session)} from herdr-session-manager's settings, if
    present: `{"workspaces": {"3": {"session": "myproject", "remote": "user@host"}}}`. A missing
    session means the default session, a missing remote means this computer, and an entry with
    neither isn't set."""
    try:
        with open(path) as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    out = {}
    for number, entry in ((data or {}).get("workspaces") or {}).items():
        if not isinstance(entry, dict) or not str(number).isdigit():
            continue
        remote = str(entry.get("remote") or "").strip()
        session = str(entry.get("session") or "").strip()
        if not remote and not session:
            continue
        out[int(number)] = (LOCAL if not remote else host_key_for(remote), session or "default")
    return out


def workspace_for(host, session, host_key_for, workspaces_in_use, path=SESSION_MANAGER):
    """Where a new window for a session goes: the workspace herdr-session-manager assigns to it,
    else the first empty workspace (1-9, then 0) that isn't assigned to another session."""
    assigned = session_workspaces(host_key_for, path)
    mine = sorted(n for n, target in assigned.items() if target == (host, session))
    if mine:
        return mine[0]
    for number in range(1, 11):
        if number not in workspaces_in_use and number not in assigned:
            return number
    return None


def workspaces_in_use():
    return {w.get("id") for w in (hypr_json("workspaces") or []) if (w.get("windows") or 0) > 0}


def switch_workspace(number):
    out = hyprctl("dispatch", "hl.dsp.focus({ workspace = '%d' })" % number)
    if out.strip() != "ok":
        hyprctl("dispatch", "workspace", str(number))


def choose_window(candidates, workspace):
    here = [w for w in candidates if w["workspace"] == workspace]
    pool = here or candidates
    return sorted(pool, key=lambda w: w["focus_rank"])[0]


def hyprland_events(events):
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not signature or not runtime:
        return
    path = os.path.join(runtime, "hypr", signature, ".socket2.sock")
    while True:
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(path)
            buf = b""
            while True:
                chunk = sock.recv(1 << 16)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    name, _, data = line.decode("utf-8", "replace").partition(">>")
                    if name in ("activewindowv2", "openwindow", "closewindow", "movewindowv2"):
                        events.put(("hypr", name, data))
        except OSError:
            pass
        time.sleep(2)


# ---------------------------------------------------------------- the list

class Watcher:
    def __init__(self, remotes, seen_after=SEEN_AFTER, persist=False):
        self.events = queue.Queue()
        self.persist = persist  # only the running watcher keeps the state file
        self.seen_after = seen_after
        self.hosts = {}
        self.host_order = [LOCAL]
        self.hosts[LOCAL] = Host(LOCAL, "this computer", None, self.events)
        self.targets = {}
        self.follow_config = remotes is None  # no --remote: follow the setting in shell.json
        self.config_mtime = None
        self.started = False
        self.set_remotes(remotes if remotes is not None else (configured_remotes() or []))
        self.sessions = {}      # (host, session) -> {"focus": {...}, "agents": {pane: agent}}
        self.stash = {}         # sessions of a host that reconnected, until they report again
        self.waiting = {}       # key -> since
        self.in_view = {}       # key -> first seen in view
        self.visible = set()
        self.windows = {}
        self.windows_at = 0.0
        self.active = None
        self.last_output = None
        self.dirty = True
        self.save_due = None
        self.restored = self.load()
        self.out_lock = threading.Lock()

    def set_remotes(self, remotes):
        wanted = {}
        for target in remotes:
            wanted.setdefault(ssh_identity(target), target)
        for key in [k for k in self.host_order if k != LOCAL and k not in wanted]:
            log("no longer watching", self.targets.get(key, key))
            self.hosts.pop(key).stop()
            self.host_order.remove(key)
            self.targets.pop(key, None)
            self.dirty = True
        for key, target in wanted.items():
            if key in self.hosts:
                continue
            self.hosts[key] = Host(key, short_label(target), target, self.events)
            self.targets[key] = target
            self.host_order.append(key)
            if self.started:
                self.hosts[key].start()
            self.dirty = True

    def check_config(self):
        try:
            mtime = os.stat(SHELL_CONFIG).st_mtime
        except OSError:
            return
        if mtime == self.config_mtime:
            return
        self.config_mtime = mtime
        remotes = configured_remotes()
        if remotes is not None:
            self.set_remotes(remotes)

    # ------------------------------------------------------------ state file
    def load(self):
        try:
            with open(STATE_FILE) as handle:
                data = json.load(handle)
            return {k: float(v) for k, v in (data.get("waiting") or {}).items()}
        except (OSError, ValueError, AttributeError):
            return {}

    def save(self):
        if not self.persist:
            return
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            tmp = STATE_FILE + ".tmp"
            keep = dict(self.waiting)
            for key, since in self.restored.items():
                host, name, _ = key.split("|", 2)
                if key not in keep and (host, name) not in self.sessions and host in self.hosts:
                    keep[key] = since  # not read again yet (e.g. the host hasn't reconnected)
            with open(tmp, "w") as handle:
                json.dump({"waiting": keep}, handle)
            os.replace(tmp, STATE_FILE)
        except OSError as error:
            log("could not save state:", error)

    # ------------------------------------------------------------ helpers
    def host_key_for(self, target):
        return ssh_identity(target)

    @staticmethod
    def key(host, session, pane):
        return "%s|%s|%s" % (host, session, pane)

    def start_waiting(self, key, why, since=None):
        if key not in self.waiting:
            self.waiting[key] = since or time.time()
            log("waiting:", key, "(%s)" % why)
            self.changed()

    def stop_waiting(self, key, why):
        if self.waiting.pop(key, None) is not None:
            log("not waiting:", key, "(%s)" % why)
            self.changed()

    def changed(self):
        self.dirty = True
        if self.save_due is None:
            self.save_due = time.time() + 2.0

    def refresh_windows(self):
        self.windows = window_map(self.host_key_for)
        self.windows_at = time.time()
        self.dirty = True

    # ------------------------------------------------------------ events
    def on_session(self, host, message):
        name = message.get("session")
        sk = (host, name)
        prev = self.sessions.get(sk) or self.stash.pop(sk, None)
        agents = {}
        for agent in message.get("agents") or []:
            agents[agent.get("pane")] = agent
        for pane, agent in agents.items():
            key = self.key(host, name, pane)
            status = agent.get("status")
            before = (prev or {}).get("agents", {}).get(pane) if prev else None
            if status == "working":
                self.stop_waiting(key, "working again")
            elif prev is None:
                # First look at this session since the watcher started.
                if status in ("blocked", "done"):
                    self.start_waiting(key, "first read: " + status, self.restored.get(key))
                elif status == "idle" and key in self.restored:
                    self.start_waiting(key, "first read: still waiting before restart", self.restored[key])
            elif before is None:
                if status in ("blocked", "done"):
                    self.start_waiting(key, "new agent: " + status)
            else:
                old = before.get("status")
                if status in ("blocked",) + FINISHED_STATES and status != old \
                        and not (old == "done" and status == "idle"):
                    self.start_waiting(key, "%s -> %s" % (old, status))
        if prev:
            for pane in prev.get("agents", {}):
                if pane not in agents:
                    self.stop_waiting(self.key(host, name, pane), "pane closed")
        self.sessions[sk] = {"focus": message.get("focus") or {}, "agents": agents}
        self.dirty = True

    def on_relay(self, host, message):
        kind = message.get("type")
        if kind == "hello":
            for sk in [sk for sk in self.sessions if sk[0] == host]:
                self.stash[sk] = self.sessions.pop(sk)
            self.dirty = True
        elif kind == "session":
            self.on_session(host, message)
        elif kind == "gone":
            sk = (host, message.get("session"))
            data = self.sessions.pop(sk, None) or self.stash.pop(sk, None)
            for pane in (data or {}).get("agents", {}):
                self.stop_waiting(self.key(host, sk[1], pane), "session stopped")
            self.dirty = True

    def on_hypr(self, name, data):
        if name == "activewindowv2":
            self.active = norm_address(data) or None
            if self.active and self.active not in self.windows:
                self.refresh_windows()
            # herdr learns which window is in front from the terminal's focus report;
            # read the sessions again so their focused pane reflects it.
            for host in self.hosts.values():
                host.send({"op": "refresh"})
        else:
            self.refresh_windows()
        self.dirty = True

    # ------------------------------------------------------------ in view
    def update_view(self):
        visible = set()
        window = self.windows.get(self.active) if self.active else None
        for host, name in (window or {}).get("clients", []):
            if host in self.hosts and not self.hosts[host].ok:
                continue
            session = self.sessions.get((host, name))
            if not session:
                continue
            tab = (session.get("focus") or {}).get("tab")
            if not tab:
                continue
            for pane, agent in session["agents"].items():
                if agent.get("tab") == tab:
                    visible.add(self.key(host, name, pane))
        now = time.time()
        for key in list(self.in_view):
            if key not in visible:
                del self.in_view[key]
        for key in visible:
            since = self.in_view.setdefault(key, now)
            if key in self.waiting and now - since >= self.seen_after:
                host, name, pane = key.split("|", 2)
                agent = self.sessions.get((host, name), {}).get("agents", {}).get(pane) or {}
                if agent.get("status") != "blocked":
                    self.stop_waiting(key, "in front of you for %.0fs in window %s" % (now - since, self.active))
        if visible != self.visible:
            self.visible = visible
            self.dirty = True

    # ------------------------------------------------------------ output
    def state(self):
        groups = {}
        for key, since in self.waiting.items():
            host, name, pane = key.split("|", 2)
            if host not in self.hosts or not self.hosts[host].ok:
                continue
            agent = self.sessions.get((host, name), {}).get("agents", {}).get(pane)
            if not agent or agent.get("status") == "working":
                continue
            blocked = agent.get("status") == "blocked"
            if blocked and key in self.visible:
                continue
            groups.setdefault((host, name), []).append({
                "key": key, "pane": pane, "agent": agent.get("agent") or "",
                "name": agent.get("name") or "", "title": agent.get("title") or "",
                "status": "blocked" if blocked else "finished", "since": round(since),
            })
        out = []
        for (host, name), agents in groups.items():
            agents.sort(key=lambda a: (a["status"] != "blocked", a["since"]))
            workspaces = sorted({w["workspace"] for w in self.windows.values()
                                 if (host, name) in w["clients"] and w["workspace"] is not None})
            out.append({
                "host": host, "hostLabel": "" if host == LOCAL else self.hosts[host].label,
                "session": name, "workspaces": workspaces, "agents": agents,
            })
        out.sort(key=lambda g: (not any(a["status"] == "blocked" for a in g["agents"]),
                                min(a["since"] for a in g["agents"])))
        hosts = []
        for key in self.host_order:
            host = self.hosts[key]
            hosts.append({
                "key": key, "label": host.label, "ok": host.ok, "error": host.error,
                "since": round(host.since),
                "sessions": sorted(n for (h, n) in self.sessions if h == key),
            })
        count = sum(len(g["agents"]) for g in out)
        blocked = sum(1 for g in out for a in g["agents"] if a["status"] == "blocked")
        return {"count": count, "blocked": blocked, "groups": out, "hosts": hosts}

    def output(self, force=False):
        state = self.state()
        line = json.dumps(state, separators=(",", ":"))
        if force or line != self.last_output:
            self.last_output = line
            with self.out_lock:
                sys.stdout.write(line + "\n")
                sys.stdout.flush()

    # ------------------------------------------------------------ going to an agent
    def first_key(self):
        state = self.state()
        return state["groups"][0]["agents"][0]["key"] if state["groups"] else None

    def focus_agent(self, host, session, pane):
        return self.hosts[host].send({"op": "focus", "session": session, "pane": pane, "id": str(time.time())})

    def go(self, key):
        try:
            host, session, pane = key.split("|", 2)
        except ValueError:
            return
        if host not in self.hosts:
            return
        self.events.put(("seen", key, None))
        windows = [w for w in window_map(self.host_key_for).values() if (host, session) in w["clients"]]
        if windows:
            window = choose_window(windows, active_workspace())
            focus_window(window["address"])
            time.sleep(0.25)  # the terminal reports focus to herdr, which then moves that window
            self.focus_agent(host, session, pane)
            return
        # No window shows this session. Nothing is attached to it, so focusing the agent first
        # moves no other window, and the new one opens on that agent. It opens on the session's
        # own workspace (herdr-session-manager) or the first empty one, and you go there.
        self.focus_agent(host, session, pane)
        number = workspace_for(host, session, self.host_key_for, workspaces_in_use())
        time.sleep(0.3)
        if number is not None:
            switch_workspace(number)
            time.sleep(0.15)
        command = ["herdr"]
        if host != LOCAL:
            command += ["--remote", self.targets[host]]
        if session != "default":
            command += ["--session", session]
        try:
            subprocess.Popen(["omarchy-launch-terminal"] + command, start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as error:
            log("could not open a terminal:", error)

    def handle_command(self, line):
        words = line.split()
        if not words:
            return
        if words[0] == "go" and len(words) == 2:
            threading.Thread(target=self.go, args=(words[1],), daemon=True).start()
        elif words[0] == "first":
            key = self.first_key()
            if key:
                threading.Thread(target=self.go, args=(key,), daemon=True).start()
        elif words[0] == "refresh":
            for host in self.hosts.values():
                host.send({"op": "refresh"})
            self.refresh_windows()
            self.output(force=True)

    # ------------------------------------------------------------ main loop
    def start(self, follow_desktop=True):
        self.started = True
        if self.follow_config:
            self.config_mtime = None
            self.check_config()
        for host in list(self.hosts.values()):
            if not host.is_alive():
                host.start()
        if follow_desktop:
            threading.Thread(target=hyprland_events, args=(self.events,), daemon=True).start()
            self.refresh_windows()
            active = hypr_json("activewindow") or {}
            self.active = norm_address(active.get("address")) or None

    def step(self, timeout=TICK):
        try:
            event = self.events.get(timeout=timeout)
        except queue.Empty:
            event = None
        while event is not None:
            kind, a, b = event
            if kind == "relay":
                self.on_relay(a, b)
            elif kind == "down":
                self.dirty = True
            elif kind == "hypr":
                self.on_hypr(a, b)
            elif kind == "seen":
                self.stop_waiting(a, "picked from the list")
            elif kind == "command":
                self.handle_command(a)
            try:
                event = self.events.get_nowait()
            except queue.Empty:
                event = None
        if time.time() - self.windows_at > WINDOW_RESCAN:
            self.refresh_windows()
            if self.follow_config:
                self.check_config()
        self.update_view()
        if self.save_due is not None and time.time() >= self.save_due:
            self.save_due = None
            self.save()

    def watch(self):
        self.start()

        def read_commands():
            for line in sys.stdin:
                self.events.put(("command", line.strip(), None))
            os._exit(0)  # the bar widget went away
        threading.Thread(target=read_commands, daemon=True).start()
        while True:
            self.step()
            if self.dirty:
                self.dirty = False
                self.output()


# ---------------------------------------------------------------- commands

def remotes_arg(args):
    if getattr(args, "local_only", False):
        return []
    return remotes_from(args.remote) if args.remote else None


def remotes_from(values):
    remotes = []
    for value in values or []:
        for part in value.replace(",", " ").split():
            if part and part not in remotes:
                remotes.append(part)
    return remotes


def cmd_list(args):
    watcher = Watcher(remotes_arg(args))
    watcher.start()
    deadline = time.time() + args.wait
    while time.time() < deadline:
        watcher.step()
        if all(h.ok or h.error for h in watcher.hosts.values()) and time.time() > deadline - args.wait + 3:
            break
    state = watcher.state()
    if args.json:
        print(json.dumps(state, indent=2))
        return
    for host in state["hosts"]:
        status = "ok" if host["ok"] else "can't connect: " + (host["error"] or "starting")
        print("%s (%s): %s" % (host["label"], status, ", ".join(host["sessions"]) or "no sessions"))
    print("%d waiting, %d need you" % (state["count"], state["blocked"]))
    for group in state["groups"]:
        where = "workspace " + ",".join(str(w) for w in group["workspaces"]) if group["workspaces"] else "no window"
        label = group["session"] + (" · " + group["hostLabel"] if group["hostLabel"] else "")
        print("  %s  (%s)" % (label, where))
        for agent in group["agents"]:
            print("    %-9s %-6s %s" % ("needs you" if agent["status"] == "blocked" else "finished",
                                       agent["agent"], agent["name"] or agent["title"]))


def cmd_windows(args):
    for window in window_map(ssh_identity).values():
        if window["clients"]:
            for host, session in window["clients"]:
                print("workspace %-3s 0x%s  %s  %s" % (window["workspace"], window["address"], host, session))


def cmd_plan(args):
    host = LOCAL if args.target == LOCAL else ssh_identity(args.target)
    windows = [w for w in window_map(ssh_identity).values() if (host, args.session) in w["clients"]]
    if windows:
        window = choose_window(windows, active_workspace())
        print("focus window 0x%s on workspace %s, then focus the agent in session %s"
              % (window["address"], window["workspace"], args.session))
    else:
        command = ["herdr"] + ([] if host == LOCAL else ["--remote", args.target]) + \
                  ([] if args.session == "default" else ["--session", args.session])
        number = workspace_for(host, args.session, ssh_identity, workspaces_in_use())
        where = "the current workspace" if number is None else \
            "workspace %d" % (0 if number == 10 else number)
        print("focus the agent in session %s, switch to %s, then open: omarchy-launch-terminal %s"
              % (args.session, where, " ".join(command)))


def main():
    parser = argparse.ArgumentParser(prog="herdr-dot", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command")
    watch = sub.add_parser("watch")
    watch.add_argument("--remote", action="append",
                       help="SSH target to watch (repeat, or comma-separated); without it, the plugin's "
                            "`remotes` setting in Omarchy's shell.json is used and followed")
    watch.add_argument("--local-only", action="store_true", help="watch only this computer")
    watch.add_argument("--seen-after", type=float, default=SEEN_AFTER)
    listing = sub.add_parser("list")
    listing.add_argument("--remote", action="append")
    listing.add_argument("--local-only", action="store_true")
    listing.add_argument("--json", action="store_true")
    listing.add_argument("--wait", type=float, default=12.0)
    sub.add_parser("windows")
    plan = sub.add_parser("plan")
    plan.add_argument("target")
    plan.add_argument("session")
    args = parser.parse_args()
    if args.command == "watch":
        Watcher(remotes_arg(args), args.seen_after, persist=True).watch()
    elif args.command == "list":
        cmd_list(args)
    elif args.command == "windows":
        cmd_windows(args)
    elif args.command == "plan":
        cmd_plan(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
